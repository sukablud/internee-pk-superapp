# Copy this file to .env and fill in whichever values you have.
# Everything here is optional — the app runs fully mocked with none of it set.
#
# Note on security: these are EXPO_PUBLIC_ vars, which means they get bundled
# into the client app and are extractable by anyone who has the built app.
# That's fine for Firebase's config (it's designed to be public; access is
# controlled by Firebase Security Rules, not by hiding these values) but it's
# NOT fine for the Gemini key long-term — for a real production app, proxy AI
# calls through a small backend so the key never ships to the client. For a
# prototype/internship submission this is an acceptable, disclosed tradeoff.

# --- Gemini (services/aiService.js, services/analyticsService.js) ---
# Get free keys (no credit card required) at https://aistudio.google.com
#
# The free tier is capped at roughly 20 requests PER DAY per key, so the chat
# and the analytics dashboard each take their own key. If you only set the
# first one, both features share it.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_CHAT_API_KEY=

# --- Projects file storage (services/storageService.js) ---
# From Firebase Console > Project Settings > General > Your apps > Web app config.
# Requires the project to be on the Blaze (pay-as-you-go) plan to actually use
# Storage — see the README for details.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
